# --- required ---
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
# Tailscale IP (or hostname) of the judge VM; see docs/deploy.md
JUDGE0_URL=http://100.x.y.z:2358
JUDGE0_AUTH_TOKEN=CHANGE_ME_same_as_AUTHN_TOKEN_in_judge0.conf
# --- first start only (seeded accounts); afterwards use: docker compose exec app node ... / npm run set-password ---
SEED_ADMIN_PASSWORD=CHANGE_ME_long_password
SEED_STUDENT_PASSWORD=CHANGE_ME_another_password
# --- optional ---
# JUDGE0_POLL_MS=500
# JUDGE0_MAX_WAIT_MS=120000
